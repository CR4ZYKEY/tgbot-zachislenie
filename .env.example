# Тестовый токен из @BotFather. Никогда не боевой — см. CLAUDE.md.
BOT_TOKEN=

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tgbot?schema=public"

# Часовой пояс для тихих часов (10:00–21:00 МСК)
TZ=Europe/Moscow

# Google Sheets. По спеке (раздел 8) — односторонняя выгрузка client_code
# раз в сутки. Сейчас временно (только тестовый бот, по просьбе заказчика) —
# двусторонняя синхронизация всех полей раз в минуту, см.
# src/worker/sheets-sync.service.ts. Не боевой инструмент, вернуться к спеке
# перед продакшеном.
# ID — из URL таблицы: docs.google.com/spreadsheets/d/<этот-id>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Название листа внутри таблицы (вкладка снизу), например "Лист1"
GOOGLE_SHEETS_SHEET_NAME=Лист1
# Вкладка с логом ответов/затруднений (создаётся автоматически, если её нет)
GOOGLE_SHEETS_ANSWERS_SHEET_NAME=Ответы
# Вкладка со сводной статистикой — пересчитывается целиком на каждом тике
GOOGLE_SHEETS_STATS_SHEET_NAME=Статистика
# client_email и private_key — из JSON-ключа сервисного аккаунта Google Cloud.
# Этот email должен быть добавлен в доступ к таблице как Редактор.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Граница когорт (раздел 8.2 спеки) — не менять без подтверждения заказчика
COHORT_CUTOFF_MONTH_DAY=04-15
