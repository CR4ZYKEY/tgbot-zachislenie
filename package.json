{
  "name": "tgbot-zachislenie",
  "version": "0.1.0",
  "description": "Telegram-бот «Зачисление в школу» — ЦПСО / EdPalm",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start:dev": "ts-node --transpile-only src/bot/main.ts",
    "start:prod": "node dist/bot/main.js",
    "worker:dev": "ts-node --transpile-only src/worker/main.ts",
    "worker:prod": "node dist/worker/main.js",
    "scenario:check": "ts-node --transpile-only scripts/check-scenario.ts",
    "stats": "ts-node --transpile-only scripts/stats.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
