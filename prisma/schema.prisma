// Схема БД. См. раздел 8 docs/spec.md — «Схема данных (минимум)».
//
// Намеренно НЕ заводим Postgres-enum для package/class/stage/screenId:
// это конфигурация сценария (YAML), а не структура БД. Если завтра
// добавится второй пакет или новый экран, это не должно требовать миграции.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  // Один Telegram-аккаунт родителя — несколько путей, по одному на ребёнка
  // («Мои герои», протокол КС 07.10.2026). slot — номер героя у родителя.
  tgId     BigInt
  slot     Int    @default(1)

  // Персональные данные — см. п.5 CLAUDE.md: только это и ничего сверх.
  clientCode String? @unique
  name       String?
  phone      String?

  package     String?
  class       String?
  isReturning Boolean?

  // Текущее место в сценарии — screen_id из scenario.yaml.
  stage String @default("s0")

  // Счётчик версий рендера текущего экрана. Зашивается в callback_data
  // вместе со screen_id (п.1 раздела 1 docs/spec.md, «Старые кнопки») —
  // так движок отличает нажатие на кнопку из устаревшего сообщения.
  renderVersion Int @default(0)

  // Стек посещённых screen_id для "← Назад" (раздел 1 спеки: "на предыдущий
  // экран, ответы не сбрасываются"). Явный screen.back в сценарии, если
  // задан, имеет приоритет над стеком.
  historyStack String[] @default([])

  // Попытки ввода телефона (S2b): после двух неудач — кнопка «Пропустить».
  phoneAttempts Int @default(0)

  // Telegram message_id последнего сообщения основной ленты — редактируем
  // его при переходах, вместо того чтобы слать новое сообщение на каждый
  // шаг. Экраны-оверлеи (меню/КС/устаревшая кнопка) сюда не попадают —
  // это отдельные всплывающие сообщения, не часть ленты.
  lastMessageId Int?

  // Message_id последнего показанного оверлея (меню/КС/stale/...). Перед
  // показом нового оверлея прежний удаляется — иначе повторные "☰ Меню"
  // копятся в чате одинаковыми сообщениями одно под другим.
  lastOverlayMessageId Int?

  // Куда ведёт "← Назад" у ТЕКУЩЕГО оверлея: "menu" — вернуться в меню
  // (если оверлей открыт прямым переходом из меню), NULL — вернуться в
  // основную ленту (по умолчанию, если оверлей открыт откуда угодно ещё).
  // Перезаписывается при каждом показе оверлея — не переживает переход
  // на новый оверлей/экран.
  overlayBackTarget String?

  // Точка возврата, если этап 1 отложен (E1.x -> resume_point -> E2.0).
  resumePoint     String?
  deferredStage1  Boolean @default(false)

  // Учебный год, к которому приписан родитель — раздел 8.2 спеки.
  cohortYear Int?

  consentAt    DateTime?
  // Последнее действие самого родителя (нажатие, ввод). Напоминания бота его
  // не двигают — по нему в таблице видно, когда родитель был в боте.
  lastTouchAt  DateTime?

  // Этапы, поставленные на паузу правилом «3 неотвеченных касания подряд».
  mutedStages       String[] @default([])
  consecutiveMisses Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Хеш редактируемых колонок строки (имя, телефон, пакет, класс), какими
  // бот их последний раз записал в Google-таблицу — см. sheets-sync.service.ts.
  // Строка в таблице с другим хешем — её правили руками, правка идёт в БД.
  // NULL — строки в таблице ещё нет.
  sheetSyncHash String?

  answers Answer[]
  jobs    Job[]

  // Индекс по tgId не нужен отдельно: его покрывает этот уникальный.
  @@unique([tgId, slot])
  @@map("users")
}

// Лист «Затруднения» — каждый ответ на экране, включая свободный ввод
// и выбор кнопки в развилках «Что происходит?» / «Что мешает?».
model Answer {
  id        String   @id @default(cuid())
  userId    String
  screenId  String
  value     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // userId+createdAt — последний ответ родителя (статус в таблице) и
  // skipIfAnswered напоминаний; createdAt — выгрузка новых ответов раз в минуту.
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("answers")
}

// Очередь напоминаний. dedup_key гарантирует, что рестарт воркера
// не продублирует отправку (раздел 8, «Гигиена касаний»).
model Job {
  id       String   @id @default(cuid())
  userId   String
  jobType  String
  runAt    DateTime
  dedupKey String   @unique

  // pending | sent | answered | failed | cancelled
  status String @default("pending")

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // runAt+status — очередь воркера; userId+status — «одно касание в сутки»
  // и ближайшее напоминание родителя в таблице.
  @@index([runAt, status])
  @@index([userId, status])
  @@map("jobs")
}

// Курсор выгрузки answers во вкладку "Ответы" Google-таблицы, см.
// src/worker/sheets-sync.service.ts. Хранит момент последнего
// выгруженного ответа по времени, а не по количеству строк — иначе
// "газ с начала" (массовое удаление users/answers) сбивал бы выгрузку.
model SyncCursor {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("sync_cursors")
}

// Telegram file_id уже загруженных картинок экранов. После первой заливки
// файла Telegram отдаёт file_id, и дальше картинка отправляется по нему —
// без повторной загрузки байтов, почти мгновенно. Раньше это жило только в
// памяти процесса и терялось на каждом рестарте; в БД кэш общий для bot и
// worker и переживает перезапуски.
// fingerprint — sha1 содержимого файла: заменили картинку под тем же именем —
// отпечаток не совпадёт, и файл зальётся заново. file_id привязан к боту,
// поэтому смена токена лечится так же — отправка по старому id падает, и
// рендер перезаливает файл (см. screen-renderer.service.ts).
model PhotoCache {
  path        String   @id // путь относительно assets/, например "shots/s0-welcome-letter.jpg"
  fingerprint String
  fileId      String
  updatedAt   DateTime @updatedAt

  @@map("photo_cache")
}

// Какой из путей родителя сейчас выбран: на него идут /start, свободный ввод
// и кнопки старых сообщений без номера героя.
model ParentState {
  tgId       BigInt   @id
  activeSlot Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@map("parent_state")
}
